{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc --noEmit",
		"compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "bun run --hot src/index.ts",
		"start": "bun run dist/index.mjs",
		"env:generate": "varlock codegen"
	},
	"dependencies": {
		"@almanac/core": "workspace:*",
		"chokidar": "^5.0.0",
		"hono": "^4.13.7",
		"varlock": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@almanac/config": "workspace:*",
		"@types/bun": "catalog:",
		"@types/node": "^26.6.2",
		"tsdown": "^0.23.0",
		"typescript": "catalog:"
	}
}
