{
	"name": "almanac",
	"private": true,
	"license": "MIT",
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"zod": "^4.5.4",
			"typescript": "^6.0.3",
			"@types/bun": "^1.4.2",
			"varlock": "1.18.0",
			"lucide-react": "^1.41.0",
			"next-themes": "^0.4.6",
			"react": "^19.2.8",
			"react-dom": "^19.2.8",
			"sonner": "^2.0.8",
			"@tailwindcss/postcss": "^4.3.3",
			"@types/react": "^19.2.18",
			"@types/react-dom": "^19.2.7",
			"tailwindcss": "^4.3.3"
		}
	},
	"type": "module",
	"bin": {
		"almanac": "./packages/cli/dist/index.js"
	},
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:web": "turbo run dev -F web --",
		"dev:server": "turbo run dev -F server --",
		"env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/",
		"postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/",
		"check": "biome check --write .",
		"prepare": "husky"
	},
	"dependencies": {
		"@types/node": "^26.6.2",
		"gray-matter": "^4.0.3",
		"ioredis": "^5.8.2",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@almanac/config": "workspace:*",
		"@biomejs/biome": "^2.5.12",
		"@types/bun": "catalog:",
		"husky": "^9.1.7",
		"lint-staged": "^17.5.0",
		"turbo": "^2.10.12",
		"typescript": "catalog:",
		"varlock": "catalog:"
	},
	"overrides": {
		"@next/env": "npm:@varlock/nextjs-integration@1.2.2"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
			"biome check --write --no-errors-on-unmatched"
		]
	},
	"packageManager": "bun@1.4.2"
}
